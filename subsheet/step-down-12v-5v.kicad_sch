	(text "When selecting inductor, consider\nmax current AND saturation current\n\nI_{PEAK} = I_{MAX} + (I_{RIPPLE} / 2)\n      = 3A + 0.5*1.5A\n      = 3.75A"
		(exclude_from_sim no)
		(at 134.62 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b3f81bbe-2cfb-4df5-8613-e3ee9fddeaac")
	)
	(text "I_{OUT} | eff. | I_{IN}\n0.5A | 95% | 0.22A\n1.0A | 95% | 0.45A\n2.0A | 94% | 0.9A\n3.0A | 92% | 1.38A @ 11.8V\n3.0A | 92% | 1.55A @ 10.5V\n\nKeep that in mind when\nbudgeting the 12V rail."
		(exclude_from_sim no)
		(at 43.18 81.28 0)
		(effects
			(font
