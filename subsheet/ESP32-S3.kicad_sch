	(text "Some pins are used for bootstrapping, and thus\nthey must have the correct state when booting:\nGPIO- state - reason\n0   - FLOAT - Allows code to be downloaded\n46  - LOW/FLOAT - Download boot mode\n		- Only checked if 0 is LOW\n45  - LOW/FLOAT - Flash voltage\n		- Can be disabled by burning an eFuse\n43	- OUTPUT (bootloader messages)\n		- Can be disabled by burning an eFuse\n\nADC1 (10 channels) available on GPIO's 1-10\nADC2 on GPIO's 11-18. Not available with WiFi"
		(exclude_from_sim no)
		(at 229.362 73.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "705a7de5-dd60-4b50-9265-07426df3402b")
	)
	(text "Gnd\nTx\nRx\n3v3\nEN\nBoot"
		(exclude_from_sim no)
		(at 16.51 90.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a20d5cd2-0f61-42b9-9c1a-51f6c5b083dc")
	)
	(text "This RC circuit is\nESSENTIAL to the\nauto-programming\ncircuits function."
		(exclude_from_sim no)
		(at 69.85 118.11 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
