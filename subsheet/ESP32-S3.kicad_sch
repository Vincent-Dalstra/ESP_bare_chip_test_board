	(text "JTAG (MTCK/DO/DI/MS) pins\nare useable as GPIO by default"
		(exclude_from_sim no)
		(at 116.84 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1b495060-74a8-45a1-906d-a3325ea66cce")
	)
	(text "Power on light"
		(exclude_from_sim no)
		(at 227.33 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2374da3e-aeeb-4793-9465-992a4ff97dd5")
	)
	(text "Some pins are used for bootstrapping, and thus\nthey must have the correct state when booting:\nGPIO- state - reason\n0   - FLOAT - Allows code to be downloaded\n46  - LOW/FLOAT - Download boot mode\n		- Only checked if 0 is LOW\n45  - LOW/FLOAT - Flash voltage\n		- Can be disabled using by an eFuse\n\nADC1 (10 channels) available on GPIO's 1-10\nADC2 on GPIO's 11-18. Not available with WiFi\n\nFastest SPI uses GPIO's 9-14"
		(exclude_from_sim no)
		(at 231.14 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7d4b195d-f102-451f-834a-9160451b61fb")
	)
	(text "Gnd\nTx\nRx\n3v3\nEN\nBoot"
		(exclude_from_sim no)
		(at 16.51 90.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a20d5cd2-0f61-42b9-9c1a-51f6c5b083dc")
	)
	(text "This RC circuit is\nESSENTIAL to the\nauto-programming\ncircuits function."
		(exclude_from_sim no)
		(at 69.85 118.11 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "bc8c5fac-7d86-4b12-a036-b69c5250a080")
	)
	(text "Use these pins last:\n26 is unavailable when using PSRAM\n33-37 are unavailable when using octal flash"
		(exclude_from_sim no)
		(at 116.84 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e3453739-7ba8-4225-b13f-2cdf8f4759b8")
	)
	(text "Diode prevents power from USB or UART programmer\nfrom backfeeding into the 5V and 12V lines. Also\nmeans we don't have to worry about the power draw\nof any 5v devices or the Ethernet while flashing."
		(exclude_from_sim no)
		(at 66.04 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e88e7340-2ba3-4764-88b4-0c1b96318a99")
	)
