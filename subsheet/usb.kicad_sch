	(text "Useful note: the FUSB302 does not\ngenerate interrupts until you explicitly\ntell it to by writing a 0 to the mask bit.\n\nHandy when sharing interrupts between devices;\nit will play nice when you don't configure\nthe chip and leave it in its default state (sink)."
		(exclude_from_sim no)
		(at 149.86 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "20676ba9-712f-4d8a-98c8-e58406a64524")
	)
	(text "Open-drain"
		(exclude_from_sim no)
		(at 167.64 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "23923b12-346e-49dc-bcf4-2d725b6754d7")
	)
	(text "Same power supply as that of\nthe microcontroller (supplying\nthe IO lines)."
		(exclude_from_sim no)
		(at 88.9 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "28754db9-6f95-404e-85f8-c051a3a8a0cd")
	)
	(text "Same power supply as that of\nthe microcontroller (supplying\nthe IO lines)."
		(exclude_from_sim no)
		(at -2.54 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "67492224-062b-4051-b8c6-6761340d92ff")
	)
	(text "VBUS on the FUSB302 is an input only.\n\nTo supply power to a power-consumer, a\nseparate load-switch must be used."
		(exclude_from_sim no)
		(at 104.14 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "767c2b68-7448-42da-adcf-dcd49318e17d")
	)
	(text "VDD must be 5V\nVCONN can be 3V3 or 5V"
		(exclude_from_sim no)
		(at 149.86 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a98a3c72-9a64-4e61-b088-8b9d6ed66f75")
	)
	(text "CC may be clamped at 2.9V or higher\n(Will not go above 2.1V in normal operation)\nSee p.253 of USB-C spec"
		(exclude_from_sim no)
		(at 99.06 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bcb75220-2b90-4a7d-882c-e1d3b6cb84a0")
	)
